# CryptoAlerts Root Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/cryptoalerts

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_here_cryptoalerts_2026
JWT_EXPIRES_IN=7d

# Message Queue (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=crypto-alert-notifications
RABBITMQ_DLQ=crypto-alert-notifications-dlq
RABBITMQ_EXCHANGE=crypto-alerts-exchange

# External Cryptocurrency Market Data (CoinGecko API)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
PRICE_CACHE_TTL_SECONDS=60

# Price Monitoring Job (Cron expression, e.g. every 30 seconds)
CRON_SCHEDULE=*/30 * * * * *
